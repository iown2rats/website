# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Runtime: Supavisor transaction pooler, port 6543, prepared statements off.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Tooling (prisma migrate / seed): session pooler on 5432 (IPv4-safe) or direct connection.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Local development alternative (see README): postgresql://postgres:postgres@localhost:5432/thundi

# ── Supabase (storage) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."            # server only, never NEXT_PUBLIC

# ── Secrets (32+ random bytes each, e.g. `openssl rand -hex 32`) ─────────────
SESSION_SECRET=""
OTP_PEPPER=""
CONTACT_HASH_SALT=""

# ── Providers (interfaces; real credentials documented when chosen) ─────────
SMS_PROVIDER="console"          # console (dev only, logs the code) | none (production placeholder until a gateway is chosen)
STORAGE_PROVIDER="local"        # local (dev/test, files under LOCAL_STORAGE_DIR served via /api/media) | supabase (needs URL + secret key + private bucket)
LOCAL_STORAGE_DIR=".storage"
SUPABASE_STORAGE_BUCKET_PHOTOS="profile-photos"   # private bucket; must be created in the Supabase project before STORAGE_PROVIDER=supabase
PAYMENT_PROVIDER="none"         # none | (provider id once selected)
VERIFICATION_PROVIDER="manual"  # manual | (provider id once selected)

# ── Photo visibility (src/lib/photo-policy.ts) ──────────────────────────────
# approved-and-pending (default outside production: no moderation pipeline yet) | approved-only (production default and the
# only value production accepts). Launching with PENDING photos visible requires a moderation workflow or an approved policy.
# PHOTO_VISIBILITY_POLICY="approved-and-pending"

# ── Development only ────────────────────────────────────────────────────────
# Echoes the OTP back to the client in development. Boot fails in production if set.
THUNDI_DEV_OTP_ECHO="true"
APP_URL="http://localhost:3000"

# ── Tests ───────────────────────────────────────────────────────────────────
# Integration tests create a throwaway database per run on this server.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/postgres"
