// Mellocrush — Prisma schema (Phase 3)
// Rationale for constraints and indexes: docs/ARCHITECTURE.md §5 and §12.
// Datasource URL is configured in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Gender {
  WOMAN
  MAN
  UNSPECIFIED // "Prefer not to say"
}

enum InterestedIn {
  WOMEN
  MEN
  EVERYONE
}

/// Dating or Friendship: what a member is here for. NOT `RelationshipIntent`, which is the romantic
/// "how serious?" detail asked only of people who came here to date (src/server/preferences/intent-policy.ts).
enum ConnectionIntent {
  DATING
  FRIENDSHIP
}

enum RelationshipIntent {
  SERIOUS_RELATIONSHIP
  DATING
  MARRIAGE
  FIGURING_OUT
}

/// Which domain an account belongs to (docs/ARCHITECTURE.md §22.1). This is the account's *domain*, not its
/// authorisation: MEMBER accounts are dating accounts, STAFF accounts are operational. The two are mutually
/// exclusive and a person must never function as both. `UserRole` layers authority on top of a STAFF account.
///
/// Invariants, enforced server-side and asserted by tests:
///  - a STAFF account has no Profile, no ProfilePhoto, no DiscoveryPreferences, no PrivacySettings and no
///    Verification row, never appears in discovery or Community, and cannot reach any member server action;
///  - a MEMBER account can never satisfy `requireStaff()`, whatever its role column says.
enum AccountType {
  MEMBER
  STAFF
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

/// Lifecycle of one staff authorisation (docs/ARCHITECTURE.md §22.2). PENDING is an invitation that nobody has
/// claimed yet; ACTIVE is a live staff authorisation bound to a User; REVOKED is permanently spent. A revoked row
/// is never reused — re-authorising the same address creates a new grant, so the history stays readable.
enum StaffGrantStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum UserStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

/// Named onboarding stages (docs/ARCHITECTURE.md §4, Phase 5). The furthest stage the user has reached;
/// each stage's save action advances it. COMPLETE is set only by the completion action after validating all required data.
enum OnboardingStage {
  NAME
  DOB
  GENDER
  CONNECTION
  MEET
  INTENT
  LOCATION
  PHOTOS
  ABOUT
  PRIVACY
  COMPLETE
}

/// Discovery visibility chosen by the user. "Only people I like" is Invisible Mode (Plus), stored separately.
enum ProfileVisibility {
  EVERYONE
  HIDDEN
}

enum LocationKind {
  CITY
  ISLAND
  ATOLL
}

enum LocationScope {
  ANYWHERE
  GREATER_MALE
  MY_ATOLL
  SPECIFIC
}

enum PhotoModeration {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
}

/// PENDING = created by an intro before a mutual like; ACTIVE = matched; LOCKED = unmatched or blocked (read-only evidence).
enum ConversationStatus {
  PENDING
  ACTIVE
  LOCKED
}

enum MessageKind {
  TEXT
  INTRO
  SYSTEM
}

/// The one set of reactions the whole product offers, in the order the picker shows them:
/// ❤️ 😂 😮 😢 👍 🔥.
///
/// An enum and not a string, because "reaction values restricted to the approved set" is an integrity rule and
/// belongs where it cannot be bypassed. A string column would let any write path — a future admin tool, a script,
/// a mistake — put an arbitrary emoji (or a megabyte of text) on a message, and every reader would then have to
/// defend itself. The database refuses instead.
///
/// The names are deliberately semantic rather than the characters themselves: the glyph a client draws is a
/// presentation decision (src/lib/reactions.ts), so the set can be re-skinned without a data migration, and a row
/// written today still means the same thing if the artwork changes.
enum ReactionEmoji {
  HEART
  LAUGH
  WOW
  SAD
  THUMBS_UP
  FIRE
}

enum ReportReason {
  FAKE_PROFILE
  UNDERAGE_USER
  HARASSMENT
  INAPPROPRIATE_CONTENT
  SCAM_OR_FINANCIAL_REQUEST
  IMPERSONATION
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum VerificationStatus {
  NONE
  /// Legacy value from SMS sign-in; no longer assigned (Google sign-in does not verify a phone). Kept so the enum
  /// type need not be rebuilt; existing rows were migrated to NONE.
  PHONE_VERIFIED
  SELFIE_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum EntitlementTier {
  FREE
  PLUS
}

/// How a customer can pay for Plus. Manual bank transfer first; an automated gateway is a new value plus a
/// provider implementation, not a rewrite (docs/ARCHITECTURE.md §12.10).
enum PaymentMethodType {
  BANK_TRANSFER
}

/// Subscription order lifecycle (docs/ARCHITECTURE.md §12.12). Transitions are enforced in
/// src/server/billing/orders.ts; the client never sets a status.
enum OrderStatus {
  AWAITING_PAYMENT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// Structured outcome of the OCR-assisted receipt check (§12.14). Advisory only: never grants Plus, never moves an order.
enum ReceiptOutcome {
  MATCH
  PARTIAL_MATCH
  REVIEW_REQUIRED
  MISMATCH
  OCR_FAILED
  UNSUPPORTED_RECEIPT
}

/// Limited actions tracked by the rolling usage-window mechanism (§12.3, §12.8).
enum UsageKind {
  LIKES
  BOOSTS
}

enum NotificationType {
  NEW_MATCH
  MESSAGE
  LIKE_RECEIVED
  INTRO_RECEIVED
  COMMUNITY_LIKE
  COMMUNITY_COMMENT
  VERIFICATION_UPDATE
  SAFETY_NOTICE
  ACCOUNT_NOTICE
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  /// Someone reacted to one of your messages. Carries `conversationId` and `data.messageId`.
  MESSAGE_REACTION
  /// Someone reacted to one of your Community comments. Carries `postId` and `data.commentId`.
  ///
  /// There is deliberately no COMMUNITY_POST_REACTION: a reaction to a post IS the existing COMMUNITY_LIKE row,
  /// now carrying `data.emoji`, because the heart on a post card became the reaction control rather than gaining
  /// a rival. One act, one notification path, nothing that can report the same thing twice.
  COMMUNITY_COMMENT_REACTION
}

enum PostKind {
  TEXT
  QUESTION
  PHOTO
  POLL
  /// Shown without an author. The author FK is still set — anonymity is a PRESENTATION rule, never a gap in the
  /// record (src/server/community/dto.ts), so moderation, reports and admin keep working exactly as before.
  CONFESSION
}

/// The topic chips above the feed. A fixed list rather than free-text tags: tags on a small community fragment it,
/// and a chip row that fits on a 320px screen cannot hold an open vocabulary anyway.
enum PostTopic {
  DATING
  ADVICE
  CONFESSIONS
  QUESTIONS
  POLLS
  RANDOM
}

enum ContactHashSource {
  PICKER
  MANUAL
  NATIVE_IMPORT
}

enum BlockSource {
  MANUAL
  REPORT
}

// ───────────────────────────── Identity & account ─────────────────────────────

/// Account record. Contains the private fields (phone, DOB) that never leave the server.
model User {
  id                    String          @id @default(cuid(2))
  /// Optional. Authentication is Google-only (docs/ARCHITECTURE.md §4.1); the phone, when present, is profile /
  /// contact-blocking data and is NOT verified by sign-in.
  phoneE164             String?         @unique
  /// HMAC-SHA-256(CONTACT_HASH_SALT, phoneE164). Same keyed function as ContactHash.hash so contact matching is an indexed join.
  phoneHash             Bytes?          @unique
  phoneHashVersion      Int             @default(1)
  dateOfBirth           DateTime?       @db.Date
  gender                Gender?
  /// MEMBER (a dating account) or STAFF (an operational account). Set once at creation and changed only by the
  /// explicit, audited conversion in src/server/staff/conversion.ts — never by an ordinary role change.
  accountType           AccountType     @default(MEMBER)
  role                  UserRole        @default(USER)
  status                UserStatus      @default(ONBOARDING)
  /// Furthest onboarding stage reached. Lets a user resume exactly where they left off.
  onboardingStage       OnboardingStage @default(NAME)
  onboardingCompletedAt DateTime?
  lastActiveAt          DateTime?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  profile               Profile?
  privacy               PrivacySettings?
  discoveryPreferences  DiscoveryPreferences?
  notificationSettings  NotificationSettings?
  verification          Verification?
  identities            AuthIdentity[]
  sessions              Session[]
  authHandoffs          AuthHandoff[]
  usageCounters         UsageCounter[]
  boosts                Boost[]
  subscriptions         Subscription[]
  orders                SubscriptionOrder[]        @relation("OrderUser")
  decidedOrders         SubscriptionOrder[]        @relation("OrderDecider")
  receiptReruns         ReceiptVerification[]      @relation("ReceiptVerificationActor")
  entitlementOverrides  EntitlementOverride[]      @relation("OverrideUser")
  grantedOverrides      EntitlementOverride[]      @relation("OverrideGrantor")
  likesGiven            Like[]                     @relation("LikeFrom")
  likesReceived         Like[]                     @relation("LikeTo")
  passesGiven           Pass[]                     @relation("PassFrom")
  passesReceived        Pass[]                     @relation("PassTo")
  matchesAsA            Match[]                    @relation("MatchA")
  matchesAsB            Match[]                    @relation("MatchB")
  unmatchedMatches      Match[]                    @relation("MatchUnmatchedBy")
  conversationsAsA      Conversation[]             @relation("ConvA")
  conversationsAsB      Conversation[]             @relation("ConvB")
  participations        ConversationParticipant[]
  messages              Message[]
  introsSent            Intro[]                    @relation("IntroFrom")
  introsReceived        Intro[]                    @relation("IntroTo")
  blocksGiven           Block[]                    @relation("BlockFrom")
  blocksReceived        Block[]                    @relation("BlockTo")
  reportsFiled          Report[]                   @relation("ReportBy")
  reportsReceived       Report[]                   @relation("ReportTarget")
  reportsResolved       Report[]                   @relation("ReportResolver")
  verificationsReviewed Verification[]             @relation("VerificationReviewer")
  posts                 CommunityPost[]
  comments              CommunityComment[]
  postLikes             CommunityLike[]
  messageReactions      MessageReaction[]
  commentReactions      CommunityCommentReaction[]
  pollVotes             CommunityPollVote[]
  following             CommunityFollow[]          @relation("CommunityFollower")
  followers             CommunityFollow[]          @relation("CommunityFollowing")
  notifications         Notification[]             @relation("NotificationUser")
  notificationsActed    Notification[]             @relation("NotificationActor")
  pushSubscriptions     PushSubscription[]
  contactHashes         ContactHash[]
  auditLogs             AuditLog[]

  staffGrant          StaffGrant?   @relation("StaffGrantHolder")
  staffGrantsCreated  StaffGrant[]  @relation("StaffGrantCreator")
  staffGrantsRevoked  StaffGrant[]  @relation("StaffGrantRevoker")
  staffInvitesCreated StaffInvite[] @relation("StaffInviteCreator")

  welcomeCovers      WelcomeCover[]      @relation("WelcomeCoverCreator")
  welcomeCoverAssets WelcomeCoverAsset[] @relation("WelcomeCoverAssetCreator")

  @@index([status, onboardingCompletedAt])
  @@index([lastActiveAt])
  @@index([accountType])
}

/// One staff authorisation, keyed on a normalised email address (docs/ARCHITECTURE.md §22.2).
///
/// A grant may exist before its holder does: an ADMIN authorises an address from /admin/staff, the address receives
/// a single-use invitation link, and claiming it creates or converts the account and flips the grant to ACTIVE. A
/// grant is what `requireStaff()` checks on every request, so revoking one closes the door immediately.
///
/// `email` is stored already normalised (trimmed, lowercased). A partial unique index created in the migration
/// keeps at most one non-REVOKED grant per address, so two admins racing to authorise the same person cannot both
/// win. Nothing here ever stores a password, a hash or a raw token: the invitation token lives in StaffInvite as a
/// SHA-256 digest, and the password verifier lives on the EMAIL AuthIdentity like every other password.
model StaffGrant {
  id              String           @id @default(cuid(2))
  /// Normalised (trimmed, lowercased) address this grant authorises.
  email           String
  /// The staff authority this grant confers. Only ADMIN or MODERATOR; validated in code, never USER.
  role            UserRole
  /// Why the grant was created, for the audit trail. Free text, 3–300 characters.
  reason          String
  status          StaffGrantStatus @default(PENDING)
  createdById     String?
  createdAt       DateTime         @default(now())
  /// The account that claimed this grant. Unique: one account never holds two grants.
  claimedByUserId String?          @unique
  claimedAt       DateTime?
  revokedById     String?
  revokedAt       DateTime?
  /// Why the grant was revoked, when a reason was given.
  revokedReason   String?
  updatedAt       DateTime         @updatedAt

  createdBy User?         @relation("StaffGrantCreator", fields: [createdById], references: [id], onDelete: SetNull)
  claimedBy User?         @relation("StaffGrantHolder", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  revokedBy User?         @relation("StaffGrantRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  invites   StaffInvite[]

  @@index([status, createdAt])
  @@index([email])
}

/// A hashed, single-use, expiring invitation link for one StaffGrant (docs/ARCHITECTURE.md §22.2).
///
/// Mirrors AuthToken exactly, but hangs off the grant rather than an AuthIdentity, because a pending grant has no
/// identity yet. The raw token is 32 random bytes and exists only in the email that was sent; the row stores its
/// SHA-256. Issuing a new invite consumes the grant's outstanding ones, so only the newest link works.
model StaffInvite {
  id          String    @id @default(cuid(2))
  grantId     String
  /// SHA-256 of the raw token. The raw value is never stored, logged or audited.
  tokenHash   Bytes     @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  grant     StaffGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("StaffInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([grantId, consumedAt])
  @@index([expiresAt])
}

/// Public-facing profile. Anything selectable here may be shown to other users subject to PrivacySettings.
model Profile {
  id             String              @id @default(cuid(2))
  userId         String              @unique
  /// Opaque public identifier used in URLs instead of the database id.
  handle         String              @unique
  displayName    String
  bio            String?
  occupation     String?
  education      String?
  languages      String[]            @default([])
  heightCm       Int?
  intent         RelationshipIntent?
  locationId     String?
  /// Optional home island, never shown unless the user allows it.
  homeLocationId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location?         @relation("ProfileLocation", fields: [locationId], references: [id], onDelete: SetNull)
  homeLocation Location?         @relation("ProfileHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)
  photos       ProfilePhoto[]
  interests    ProfileInterest[]
  prompts      ProfilePrompt[]

  @@index([locationId])
  @@index([intent])
}

model ProfilePhoto {
  id         String          @id @default(cuid(2))
  profileId  String
  /// 0 = primary photo. Renumbered in one transaction on reorder.
  position   Int
  storageKey String
  thumbKey   String
  /// Precomputed blurhash placeholder; the only photo representation a Free client receives in Likes You.
  blurhash   String
  width      Int
  height     Int
  moderation PhotoModeration @default(PENDING)
  createdAt  DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, position])
  @@unique([storageKey])
}

model Location {
  id            String       @id @default(cuid(2))
  slug          String       @unique
  name          String
  kind          LocationKind
  atollCode     String
  atollName     String
  isGreaterMale Boolean      @default(false)
  sortOrder     Int          @default(0)

  profiles     Profile[]              @relation("ProfileLocation")
  homeProfiles Profile[]              @relation("ProfileHomeLocation")
  preferences  DiscoveryPreferences[]

  @@index([atollCode])
}

model Interest {
  id        String            @id @default(cuid(2))
  slug      String            @unique
  label     String
  sortOrder Int               @default(0)
  profiles  ProfileInterest[]
}

model ProfileInterest {
  profileId  String
  interestId String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
}

model Prompt {
  id        String          @id @default(cuid(2))
  slug      String          @unique
  text      String
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  answers   ProfilePrompt[]
}

model ProfilePrompt {
  id        String   @id @default(cuid(2))
  profileId String
  promptId  String
  answer    String
  position  Int
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prompt  Prompt  @relation(fields: [promptId], references: [id], onDelete: Restrict)

  @@unique([profileId, promptId])
  @@unique([profileId, position])
}

// ───────────────────────────── Settings ─────────────────────────────

model PrivacySettings {
  userId           String            @id
  visibility       ProfileVisibility @default(EVERYONE)
  /// Plus feature (§12.6). Stored as the user's wish; effective only while the entitlement is held.
  invisibleMode    Boolean           @default(false)
  hideLocation     Boolean           @default(false)
  hideAge          Boolean           @default(false)
  hideActiveStatus Boolean           @default(false)
  readReceipts     Boolean           @default(true)
  profileSharing   Boolean           @default(true)
  blockContacts    Boolean           @default(false)
  /// "Pause dating": hidden from Discover, chats keep working.
  pausedAt         DateTime?
  updatedAt        DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscoveryPreferences {
  userId                 String              @id
  /// What this member is here for. Dating is opposite-gender only; Friendship is open.
  connectionIntent       ConnectionIntent    @default(DATING)
  /// The gender preference discovery matches on, for whichever intent is active. DERIVED for Dating (a man is
  /// shown women, a woman men) and CHOSEN for Friendship. Only `resolvePreferences` writes it, so it cannot
  /// drift from the rule; it stays a column because the predicate matches it reciprocally in SQL.
  interestedIn           InterestedIn        @default(EVERYONE)
  /// The member's own Friendship answer, kept while they are on Dating so switching back does not re-ask, and so
  /// the derived Dating value is never mistaken for a choice they made.
  friendshipInterestedIn InterestedIn?
  ageMin                 Int                 @default(22)
  ageMax                 Int                 @default(34)
  locationScope          LocationScope       @default(ANYWHERE)
  locationId             String?
  intent                 RelationshipIntent?
  // Advanced (Plus) filters — ignored by the query unless the viewer holds the entitlement.
  heightMinCm            Int?
  heightMaxCm            Int?
  education              String?
  updatedAt              DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

model NotificationSettings {
  userId    String  @id
  matches   Boolean @default(true)
  likes     Boolean @default(true)
  messages  Boolean @default(true)
  community Boolean @default(false)
  marketing Boolean @default(false)

  /**
   * PUSH, which is a separate question from the five above.
   * Those decide whether a notification EXISTS — they gate the in-app feed and always have. These decide whether
   * an existing one also leaves the building. Keeping them apart is what lets somebody switch every push off and
   * keep the in-app feed exactly as it was, which is the point.
   * All default FALSE, without exception. Push needs a browser permission the member grants deliberately, and a
   * default that notified somebody's phone because a column said true would be the opposite of asking.
   */
  push          Boolean @default(false)
  pushMessages  Boolean @default(false)
  pushLikes     Boolean @default(false)
  pushMatches   Boolean @default(false)
  pushReactions Boolean @default(false)
  pushCommunity Boolean @default(false)
  /// Verification results, payments and Plus notices.
  pushAccount   Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Auth ─────────────────────────────

enum AuthProvider {
  GOOGLE
  TELEGRAM
  EMAIL
}

/// What a hashed, single-use AuthToken authorises (docs/ARCHITECTURE.md §4.1b).
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A sign-in identity from an external provider, mapped to our canonical User.id (docs/ARCHITECTURE.md §4.1).
/// One identity per (provider, subject). After account deletion the row is kept with the email and username
/// scrubbed and releasedAt set, so the same Google or Telegram account is told its previous account was deleted
/// before a new one is made. Identities are never linked across providers by name, username or email.
model AuthIdentity {
  id                String       @id @default(cuid(2))
  userId            String
  provider          AuthProvider
  /// The provider's stable subject identifier (Google `sub`, Telegram user id). Never an email: emails can change.
  providerSubject   String
  /// Google always supplies one; Telegram's OpenID Connect issues no email claim, so it is null there.
  email             String?
  emailVerified     Boolean      @default(false)
  displayName       String?
  /// Telegram `preferred_username` (without @), for display in Settings and admin only. Never used for matching.
  providerUsername  String?
  /// EMAIL only: the password verifier, `scrypt$N$r$p$salt$hash` (src/server/auth/password.ts). Never a plaintext
  /// password, never sent to a client, never shown in admin. Null for Google and Telegram identities.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  createdAt         DateTime     @default(now())
  lastLoginAt       DateTime?
  releasedAt        DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens AuthToken[]

  @@unique([provider, providerSubject])
  @@index([userId])
}

/// Email verification and password-reset tokens (docs/ARCHITECTURE.md §4.1b). Only the SHA-256 of the token is
/// stored, so a database leak cannot be replayed as a link; each row is single-use (`consumedAt`) and expires.
/// Issuing a new token of a purpose consumes the identity's outstanding ones, so only the newest link works.
model AuthToken {
  id         String           @id @default(cuid(2))
  identityId String
  purpose    AuthTokenPurpose
  /// SHA-256 of the raw token; the raw value exists only in the email that was sent.
  tokenHash  Bytes            @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  /// For EMAIL_VERIFICATION after a change of address: the address this token confirms.
  email      String?

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, purpose])
  @@index([expiresAt])
}

/// One-time exchange code that moves a completed OAuth sign-in from the system browser into the Android app's
/// WebView (docs/ARCHITECTURE.md §4.1c).
///
/// Google and Telegram both refuse OAuth inside an embedded WebView, so the Android app runs the flow in a Chrome
/// Custom Tab instead. The Custom Tab has its own cookie jar, so the session it would set there is useless to the
/// app. This row is the bridge, and it deliberately holds NO secret at rest:
///
///   - `codeHash` is SHA-256 of a 256-bit random code that exists only inside one deep link, once.
///   - `challengeHash` is SHA-256 of a verifier the app generated BEFORE it opened the browser and never sent
///     anywhere except to the redemption endpoint. A hostile app that registers the same custom scheme and
///     intercepts the deep link therefore cannot redeem the code.
///   - there is no session token here. The session is created at redemption, inside the WebView, so it carries
///     the WebView's own user agent and address rather than the browser's.
model AuthHandoff {
  id            String    @id @default(cuid(2))
  codeHash      Bytes     @unique
  challengeHash Bytes
  userId        String
  /// Where the WebView is sent once the session exists: the same landing the web callback would have chosen.
  landing       String
  provider      String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id                String    @id @default(cuid(2))
  userId            String
  tokenHash         Bytes     @unique
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  userAgent         String?
  ipPrefix          String?
  /// Set when this session completed a fresh Google re-authentication; destructive actions require it to be recent.
  reauthenticatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Postgres-backed sliding-window rate limits (OTP, uploads, message spam ceiling).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ───────────────────────────── Dating graph ─────────────────────────────

model Like {
  id         String   @id @default(cuid(2))
  fromUserId String
  toUserId   String
  introId    String?  @unique
  createdAt  DateTime @default(now())

  from  User   @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to    User   @relation("LikeTo", fields: [toUserId], references: [id], onDelete: Restrict)
  intro Intro? @relation(fields: [introId], references: [id], onDelete: SetNull)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, createdAt(sort: Desc)])
  @@index([fromUserId, createdAt(sort: Desc)])
}

model Pass {
  id         String    @id @default(cuid(2))
  fromUserId String
  toUserId   String
  createdAt  DateTime  @default(now())
  /// Passed profiles resurface after this time.
  expiresAt  DateTime
  /// Set by Undo (Plus). Never deleted, so history is preserved.
  undoneAt   DateTime?

  from User @relation("PassFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to   User @relation("PassTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, createdAt(sort: Desc)])
}

/// userAId < userBId is enforced in code; the unique pair index makes double-matching impossible.
model Match {
  id            String      @id @default(cuid(2))
  userAId       String
  userBId       String
  status        MatchStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  unmatchedAt   DateTime?
  unmatchedById String?

  userA        User          @relation("MatchA", fields: [userAId], references: [id], onDelete: Restrict)
  userB        User          @relation("MatchB", fields: [userBId], references: [id], onDelete: Restrict)
  unmatchedBy  User?         @relation("MatchUnmatchedBy", fields: [unmatchedById], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

/// One conversation per user pair (sorted). PENDING while only an intro exists, ACTIVE after a match, LOCKED after unmatch/block.
model Conversation {
  id            String             @id @default(cuid(2))
  userAId       String
  userBId       String
  matchId       String?            @unique
  status        ConversationStatus @default(PENDING)
  lastMessageAt DateTime?
  /// Last time something changed about a message that already exists here: a reaction set, changed or removed, or
  /// an edit. `lastMessageAt` cannot answer that — it moves only when a NEW message arrives, and the chat's
  /// incremental poll asks "anything after this id?", which by construction never revisits a message the client
  /// already holds. Without this column a reaction or an edit would be invisible to the other person until they
  /// reloaded. The poll carries it back and forth as an opaque watermark and refetches the visible window only
  /// when it has moved, so the steady-state poll stays one row read (docs/ARCHITECTURE.md §9.4).
  interactionAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userA         User                      @relation("ConvA", fields: [userAId], references: [id], onDelete: Restrict)
  userB         User                      @relation("ConvB", fields: [userBId], references: [id], onDelete: Restrict)
  match         Match?                    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  notifications Notification[]

  @@unique([userAId, userBId])
  @@index([status, lastMessageAt(sort: Desc)])
}

model ConversationParticipant {
  conversationId    String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime?
  mutedAt           DateTime?
  joinedAt          DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Messages are never hard-deleted (moderation evidence). The (senderId, createdAt) index serves the 9-minute cooldown check.
model Message {
  id               String      @id @default(cuid(2))
  conversationId   String
  senderId         String
  kind             MessageKind @default(TEXT)
  body             String
  createdAt        DateTime    @default(now())
  deletedAt        DateTime?
  /// The message this one is a reply to. A REFERENCE, never a copy of the quoted text: quoting by value would
  /// freeze a sentence the author may later edit, and would put a second copy of someone's words in a row they do
  /// not own. The quote is resolved at read time, so an edited original reads correctly in every reply to it.
  ///
  /// Always inside the same conversation. That is not something the column can express, so it is asserted on the
  /// way in (src/server/conversations/messages.ts) — a reply may only point at a message the sender can already
  /// see, which is the whole of the visibility rule for a conversation they are a participant in.
  replyToMessageId String?
  /// When the sender last edited the body. Null means never edited. `createdAt` is never touched by an edit, so
  /// the message keeps its place in the thread and in every cursor that has already paged past it.
  editedAt         DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  intro        Intro?
  reports      Report[]
  /// SetNull, not Cascade: if a quoted message ever did leave the table, the reply is still a real thing someone
  /// said and must survive it. The client renders the dangling case as "Message unavailable".
  replyTo      Message?          @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReply")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, kind, createdAt(sort: Desc)])
  @@index([replyToMessageId])
}

/// One person's one reaction to one message.
///
/// The composite primary key IS the "one active reaction per user per message" rule. Nothing counts rows to decide
/// whether a second is allowed, and no retry, double tap or duplicate request can produce two: changing a reaction
/// is an UPDATE of this row, removing it is a DELETE, and adding one is an upsert that conflicts with itself. That
/// is also why the emoji does not live in an array on the Message row — an array has no key, so concurrent writers
/// lose each other's changes and "remove mine" becomes a read-modify-write race.
model MessageReaction {
  messageId String
  userId    String
  emoji     ReactionEmoji
  createdAt DateTime      @default(now())
  /// Bumped when the reaction is replaced, so "when did this last change" is answerable without a second table.
  updatedAt DateTime      @default(now()) @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Intro {
  id         String   @id @default(cuid(2))
  fromUserId String
  toUserId   String
  body       String
  /// ISO week key (e.g. 2026-W38) used for the Free quota of one intro per week.
  weekKey    String
  messageId  String?  @unique
  createdAt  DateTime @default(now())

  from    User     @relation("IntroFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to      User     @relation("IntroTo", fields: [toUserId], references: [id], onDelete: Restrict)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  like    Like?

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, weekKey])
}

// ───────────────────────────── Usage limits & monetization ─────────────────────────────

/// One row per user per limited action. Locked FOR UPDATE inside the consuming transaction (§12.3, §12.11).
model UsageCounter {
  userId      String
  kind        UsageKind
  windowStart DateTime
  windowEnd   DateTime
  used        Int       @default(0)
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

model Boost {
  id        String   @id @default(cuid(2))
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt(sort: Desc)])
  @@index([endsAt])
}

/// A Plus plan as sold. `active` = enabled/visible; a plan is FOR SALE only when `active` and `isPlaceholderPrice`
/// is false (an admin has set a real price). Orders snapshot the commercial terms, so editing a plan never changes
/// what an existing customer bought.
model SubscriptionPlan {
  id                 String   @id @default(cuid(2))
  /// Stable admin-chosen identifier (e.g. MONTHLY). Free-form so plans can be added without a migration.
  code               String   @unique
  name               String
  description        String?
  intervalDays       Int
  /// Minor units (laari for MVR). Placeholder until pricing is approved.
  priceMinor         Int
  currency           String   @default("MVR")
  badge              String?
  discountLabel      String?
  isPlaceholderPrice Boolean  @default(true)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]
  orders        SubscriptionOrder[]
}

/// Where customers send money. Configured by an admin, never in source. Shown to signed-in customers at checkout;
/// snapshotted onto the order so the instructions a customer saw never change under them.
model PaymentMethod {
  id            String            @id @default(cuid(2))
  type          PaymentMethodType @default(BANK_TRANSFER)
  /// Admin label, e.g. "BML MVR account".
  label         String
  bankName      String
  accountHolder String
  accountNumber String
  currency      String            @default("MVR")
  instructions  String?
  enabled       Boolean           @default(false)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orders SubscriptionOrder[]
}

/// One purchase attempt. Immutable commercial snapshot + a server-enforced state machine. APPROVED orders own
/// exactly one Subscription (Subscription.orderId is unique), which is what makes approval idempotent.
model SubscriptionOrder {
  id              String      @id @default(cuid(2))
  /// Human-readable payment reference the customer writes on the transfer, e.g. THU-7K4P2M. Random, unique.
  reference       String      @unique
  userId          String
  planId          String
  paymentMethodId String?
  status          OrderStatus @default(AWAITING_PAYMENT)
  // ── Snapshot at creation (never rewritten) ──
  planName        String
  amountMinor     Int
  currency        String
  durationDays    Int
  methodLabel     String
  bankName        String
  accountHolder   String
  accountNumber   String
  instructions    String?
  // ── Customer submission ──
  receiptKey      String?
  receiptSize     Int?
  submittedAt     DateTime?
  // ── Decision ──
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?
  /// AWAITING_PAYMENT orders lapse to EXPIRED after this.
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User                  @relation("OrderUser", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy     User?                 @relation("OrderDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  plan          SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  subscription  Subscription?
  verifications ReceiptVerification[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, submittedAt])
  @@index([status, expiresAt])
}

/// One OCR pass over a receipt (§12.14). Written only by the server from the stored image, never from anything a browser
/// posted. Rows accumulate (one per attempt: each upload, each admin re-run) so an older reading is never rewritten by a
/// newer parser. Raw OCR text is deliberately NOT stored; only the normalised fields the check needs.
model ReceiptVerification {
  id                 String         @id @default(cuid(2))
  orderId            String
  /// 1, 2, 3… per order. Unique together with orderId.
  attempt            Int
  /// e.g. bml-v1, mib-v1, generic-v1 — which parser produced these fields.
  parserVersion      String
  /// e.g. tesseract.js-7.0.0/eng-4.0.0_best_int
  engine             String
  outcome            ReceiptOutcome
  /// BML, MIB or null when no supported bank was recognised.
  detectedBank       String?
  /// COMPLETED, PENDING, FAILED, UNKNOWN
  transactionStatus  String
  amountMinor        Int?
  currency           String?
  /// Bank transaction/reference id, normalised (upper-case, no spaces).
  transactionId      String?
  /// sha256 of the normalised transactionId; what duplicate detection indexes.
  transactionIdHash  String?
  transactionAt      DateTime?
  transactionDateRaw String?
  /// Destination account digits as read (the merchant's account when the transfer is right).
  recipientAccount   String?
  recipientName      String?
  senderName         String?
  /// Remark / reference text as read, trimmed.
  remarks            String?
  /// Per-check states: { bank, status, amount, currency, recipient, reference, transactionId, duplicate, date }.
  checks             Json
  /// Whole-document engine confidence 0–100; kept for diagnostics only, never a threshold.
  ocrConfidence      Int?
  durationMs         Int?
  /// Set when an admin re-ran OCR; null for the automatic pass at upload.
  triggeredById      String?
  createdAt          DateTime       @default(now())

  order       SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  triggeredBy User?             @relation("ReceiptVerificationActor", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@unique([orderId, attempt])
  @@index([orderId, createdAt(sort: Desc)])
  @@index([transactionIdHash])
}

/// Written only by the admin payment approval (src/server/billing/approval.ts) or a future gateway webhook.
/// Never by a user-facing action.
model Subscription {
  id                      String             @id @default(cuid(2))
  userId                  String
  planId                  String
  status                  SubscriptionStatus
  provider                String
  providerCustomerRef     String?
  providerSubscriptionRef String?            @unique
  startedAt               DateTime
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean            @default(false)
  cancelledAt             DateTime?
  /// The approved manual order that created this subscription (unique: one order activates at most one period).
  orderId                 String?            @unique
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  order SubscriptionOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, currentPeriodEnd(sort: Desc)])
  @@index([status, currentPeriodEnd])
}

/// Admin/dev grant of a tier for a period (e.g. support goodwill, QA). Also used by tests.
model EntitlementOverride {
  id          String          @id @default(cuid(2))
  userId      String
  tier        EntitlementTier
  reason      String
  grantedById String?
  startsAt    DateTime        @default(now())
  endsAt      DateTime
  createdAt   DateTime        @default(now())

  user      User  @relation("OverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("OverrideGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, endsAt(sort: Desc)])
}

// ───────────────────────────── Safety & moderation ─────────────────────────────

model Block {
  id        String      @id @default(cuid(2))
  blockerId String
  blockedId String
  source    BlockSource @default(MANUAL)
  createdAt DateTime    @default(now())

  blocker User @relation("BlockFrom", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTo", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Polymorphic target: exactly one of targetUserId / targetPostId / targetCommentId / targetMessageId is set (checked in code).
model Report {
  id              String       @id @default(cuid(2))
  reporterId      String
  targetUserId    String?
  targetPostId    String?
  targetCommentId String?
  targetMessageId String?
  reason          ReportReason
  note            String?
  /// Snapshot of the reported content at report time so later deletion does not destroy evidence.
  snapshot        Json?
  status          ReportStatus @default(OPEN)
  resolvedById    String?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime     @default(now())

  reporter      User              @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Restrict)
  targetUser    User?             @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetPost    CommunityPost?    @relation(fields: [targetPostId], references: [id], onDelete: Restrict)
  targetComment CommunityComment? @relation(fields: [targetCommentId], references: [id], onDelete: Restrict)
  targetMessage Message?          @relation(fields: [targetMessageId], references: [id], onDelete: Restrict)
  resolvedBy    User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([targetCommentId])
}

model Verification {
  userId           String             @id
  status           VerificationStatus @default(NONE)
  selfieStorageKey String?
  provider         String?
  providerRef      String?
  submittedAt      DateTime?
  reviewedById     String?
  decidedAt        DateTime?
  rejectionReason  String?
  attempts         Int                @default(0)
  updatedAt        DateTime           @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
}

// ───────────────────────────── Community ─────────────────────────────

model CommunityPost {
  id              String          @id @default(cuid(2))
  authorId        String
  kind            PostKind        @default(TEXT)
  /// Which chip this post sits under. Null means it predates topics, or the author chose none.
  topic           PostTopic?
  /// Hide the author from other members. NEVER clears authorId: see PostKind.CONFESSION.
  isAnonymous     Boolean         @default(false)
  body            String
  photoKey        String?
  photoBlurhash   String?
  /// Community media has its own moderation state (src/lib/photo-policy.ts decides what other users may see).
  photoModeration PhotoModeration @default(PENDING)
  likeCount       Int             @default(0)
  commentCount    Int             @default(0)
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  author        User                  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comments      CommunityComment[]
  likes         CommunityLike[]
  reports       Report[]
  notifications Notification[]
  pollOptions   CommunityPollOption[]
  pollVotes     CommunityPollVote[]

  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([authorId])
  /// The topic chips filter on this, newest first, over live posts only.
  @@index([topic, deletedAt, createdAt(sort: Desc)])
}

/// One answer on a poll. `voteCount` is denormalised for the same reason CommunityPost.likeCount is: the feed
/// renders percentages for every option of every visible poll, and counting rows per option per render does not
/// survive a page of them.
model CommunityPollOption {
  id        String   @id @default(cuid(2))
  postId    String
  label     String
  position  Int
  voteCount Int      @default(0)
  createdAt DateTime @default(now())

  post  CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes CommunityPollVote[]

  @@unique([postId, position])
  @@index([postId])
}

/// One member's vote. The composite primary key is the rule: one vote per person per poll, enforced by the
/// database rather than by a check the application has to remember to make. Changing a vote updates this row.
model CommunityPollVote {
  postId    String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  post   CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  option CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([optionId])
}

/// A one-directional, PRIVATE follow (owner decision, 2026-09-21). It feeds the Following tab and nothing else:
/// the person followed is never notified, never sees who follows them, and no follower count is exposed anywhere.
/// On a dating app a visible follow is a way to tell someone they are being watched, which is the behaviour the
/// Community Guidelines call stalking. Blocking in either direction removes the row.
model CommunityFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("CommunityFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("CommunityFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  /// "Whose posts go in my Following tab?"
  @@index([followerId, createdAt(sort: Desc)])
  @@index([followingId])
}

model CommunityComment {
  id        String    @id @default(cuid(2))
  postId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  post      CommunityPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User                       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reports   Report[]
  reactions CommunityCommentReaction[]

  @@index([postId, createdAt])
}

/// One person's one reaction to one post. Named `CommunityLike` because that is what it was: the single heart of
/// the prototype. It is the post reaction table now, and the name is kept on purpose — renaming a live table is
/// not an additive migration, and every existing row is already exactly what it should be, a ❤️ from that user on
/// that post, which is why `emoji` defaults to HEART and no row had to be rewritten.
///
/// `CommunityPost.likeCount` is therefore the total number of reactions, which it already was: the primary key
/// below has always allowed one per member per post, so the counter never counted anything else. Popular Today,
/// the social-context line and the COMMUNITY_LIKE notification keep working untouched.
model CommunityLike {
  postId    String
  userId    String
  emoji     ReactionEmoji @default(HEART)
  createdAt DateTime      @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// One person's one reaction to one comment. A separate model from CommunityLike and MessageReaction rather than
/// one polymorphic `reactions` table with a nullable FK per kind of target: a real foreign key per target means
/// the database refuses a reaction to a comment that does not exist, ON DELETE CASCADE needs no application code,
/// and no read has to ask "which of these three columns is set?" before it can authorise anything.
model CommunityCommentReaction {
  commentId String
  userId    String
  emoji     ReactionEmoji
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id             String           @id @default(cuid(2))
  userId         String
  type           NotificationType
  actorId        String?
  conversationId String?
  postId         String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User           @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  pushes       PushDelivery[]
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  post         CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

/// How a device is reached. WEBPUSH is the IETF Web Push Protocol (RFC 8030/8291) and is all that is implemented;
/// FCM exists so the Android shell can be added without a second delivery path, since a Capacitor WebView cannot
/// receive web push (docs/ARCHITECTURE.md §29.4).
enum PushTransport {
  WEBPUSH
  FCM
}

/// One browser or device a member has allowed to notify them.
///
/// A ROW PER DEVICE, never a token on the User row: one person legitimately has a laptop, a phone browser and the
/// Android app at once, and each has its own endpoint, its own keys and its own way of going stale. A single
/// column would silently drop every device but the last one to ask.
///
/// Nothing here is deleted when it breaks. A push service answering 404 or 410 means that endpoint is gone for
/// good, so `disabledAt` is set and it is never tried again — but the row stays, because the same browser
/// re-subscribing gets the same endpoint back and must be recognised rather than duplicated.
model PushSubscription {
  id           String        @id @default(cuid(2))
  userId       String
  transport    PushTransport @default(WEBPUSH)
  /// Web Push: the endpoint URL the push service issued to this browser. FCM: the device token. Unique either
  /// way, which is what makes re-subscribing an upsert rather than a second row.
  endpoint     String        @unique
  /// Web Push: `{ p256dh, auth }`, the browser's own public key and auth secret. These are what make the payload
  /// readable by this browser ALONE — the push service relays ciphertext it cannot open. Never logged.
  keys         Json
  /// For the member's own "signed-in devices" list. Display only; never used to make a decision.
  userAgent    String?
  lastSeenAt   DateTime?
  /// Consecutive transient failures. Reset on success; a permanent failure disables outright instead.
  failureCount Int           @default(0)
  /// Set when the endpoint is gone (404/410) or has failed too many times. A disabled row is never sent to again.
  disabledAt   DateTime?
  createdAt    DateTime      @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId])
  /// The send path's only lookup: this member's devices that are still worth trying.
  @@index([userId, disabledAt])
}

enum PushDeliveryStatus {
  /// Claimed, not yet confirmed sent. A row stuck here is retried by the sweep, bounded by `attempts`.
  PENDING
  SENT
  FAILED
}

/// One attempt to push one notification to one device — and THE IDEMPOTENCY KEY of the whole system.
///
/// `@@unique([notificationId, subscriptionId])` is what makes "a retry cannot send twice" a property of the
/// database rather than a promise made by the code. The sender does not check-then-send; it INSERTs the claim
/// first with ON CONFLICT DO NOTHING, and only the request that actually won the insert goes on to send. A job
/// retrying, a request replayed, a page polling, a user reconnecting and a background sweep running again all
/// collide with the same row and do nothing. This is deliberately the guarantee that the in-app notification
/// producers get from an advisory lock, moved into a constraint.
model PushDelivery {
  id             String             @id @default(cuid(2))
  notificationId String
  subscriptionId String
  status         PushDeliveryStatus @default(PENDING)
  attempts       Int                @default(0)
  /// Why it failed, for support. A provider's message, never a payload.
  error          String?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

  notification Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, subscriptionId])
  @@index([status, createdAt])
}

// ───────────────────────────── Contact blocking ─────────────────────────────

/// See docs/CONTACT_BLOCKING.md. Hash = HMAC-SHA-256(salt, E.164). No plaintext, no names.
model ContactHash {
  id          String            @id @default(cuid(2))
  userId      String
  hash        Bytes
  hashVersion Int               @default(1)
  source      ContactHashSource
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([hash])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  data       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Which screen shape a cover image was cut for (docs/ARCHITECTURE.md §26). Not a viewport size: the browser picks
/// one with a `media` query, and the same image then covers whatever the viewport actually is.
enum WelcomeCoverVariant {
  MOBILE
  TABLET
  DESKTOP
}

/// DRAFT and ARCHIVED are stored; "scheduled" and "expired" are NOT. A cover with a future `startsAt` is scheduled
/// and one whose `endsAt` has passed is expired, both derived from PUBLISHED + the clock at read time. Storing them
/// would need a job to flip the rows, and a job that has not run yet is a promotion that did not start.
enum WelcomeCoverStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// One uploaded cover image. Separate from the campaign so its real dimensions, weight and blurhash have a home,
/// and so an archived campaign keeps pointing at the artwork it published rather than at whatever replaced it.
model WelcomeCoverAsset {
  id          String              @id @default(cuid(2))
  variant     WelcomeCoverVariant
  /// welcome-covers/<id>.webp — unique per upload, never reused. That is what makes the public URL immutable, so
  /// publishing new artwork can never leave a browser or CDN showing the old one.
  storageKey  String              @unique
  width       Int
  height      Int
  bytes       Int
  blurhash    String
  createdById String?
  createdAt   DateTime            @default(now())

  createdBy       User?          @relation("WelcomeCoverAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  coversAsMobile  WelcomeCover[] @relation("WelcomeCoverMobile")
  coversAsTablet  WelcomeCover[] @relation("WelcomeCoverTablet")
  coversAsDesktop WelcomeCover[] @relation("WelcomeCoverDesktop")
}

/// One Welcome Screen cover / promotion. Every variant is optional: a cover with only a mobile image is legitimate,
/// and the other two fall back to the built-in defaults per device (src/server/welcome/defaults.ts) rather than
/// stretching the one that was supplied.
model WelcomeCover {
  id             String             @id @default(cuid(2))
  name           String
  status         WelcomeCoverStatus @default(DRAFT)
  mobileAssetId  String?
  tabletAssetId  String?
  desktopAssetId String?
  /// Optional promotion window. Null start = live as soon as it is published; null end = until something replaces it.
  startsAt       DateTime?
  endsAt         DateTime?
  publishedAt    DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  mobileAsset  WelcomeCoverAsset? @relation("WelcomeCoverMobile", fields: [mobileAssetId], references: [id], onDelete: SetNull)
  tabletAsset  WelcomeCoverAsset? @relation("WelcomeCoverTablet", fields: [tabletAssetId], references: [id], onDelete: SetNull)
  desktopAsset WelcomeCoverAsset? @relation("WelcomeCoverDesktop", fields: [desktopAssetId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("WelcomeCoverCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The selection query: PUBLISHED rows whose window contains "now".
  @@index([status, startsAt, endsAt])
}
